# Server
PORT=3000

# SFT (SmartCourier) API
SFT_BASE_URL=https://smartcourier.pk/api
SFT_API_KEY=your_api_key_here
SFT_CREDENTIALS=your_base64_credentials_here

# Keep true until real SFT test credentials exist (see README open questions).
# true  -> /rates returns realistic mock data (matches the PDF sample response), no real SFT call
# false -> real call to SFT's /v2/tarrif using the credentials above
SFT_MOCK_MODE=true

# Shopify Admin API — needs BOTH scopes on the same custom app token:
#   write_shipping  (registers the CarrierService, see scripts/registerCarrierService.js)
#   read_products    (reads dimension metafields, see src/services/shopifyAdmin.js)
SHOPIFY_STORE_DOMAIN=client-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxx_custom_app_token
SHOPIFY_API_VERSION=2024-10
CARRIER_SERVICE_CALLBACK_URL=https://your-deployed-backend.example.com/rates

# Keep true until the client's store + real product dimension metafields exist.
# true  -> dimension lookups return mock data (see MOCK_DIMENSIONS_BY_PRODUCT_ID in shopifyAdmin.js)
# false -> real GraphQL call to Shopify Admin API
SHOPIFY_ADMIN_MOCK_MODE=true

# /admin settings page (currency rates + dimensional weight divisor) — Basic Auth.
# CHANGE THESE before deploying anywhere reachable from the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying

# Operator API — Bearer token for POST/GET/DELETE /operator/stores (multi-store admin).
# Generate one with: openssl rand -hex 32
OPERATOR_API_KEY=replace_with_a_long_random_secret
